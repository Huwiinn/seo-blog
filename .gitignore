# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .md file
/memory
# sqlite 임시 파일 (DB 본체 data/blog.db는 커밋한다)
data/*.db-journal
data/*.db-wal
data/*.db-shm

# 출처 표기가 있던 이전 원고 보관본 (발행하지 않는다)
/content/_archive/
# 발행하지 않기로 한 원고 (공개 저장소에 올리지 않는다)
/content/wiki-posts/_held-*
